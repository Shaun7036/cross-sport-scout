---
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const active = (path: string) => pathname.startsWith(href(path));
const isFindings = active("research/findings/");
const isStories = active("stories/") || active("featured/");
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={href("")} aria-label="The Multi Sport Scouter home">
      <span class="brand-mark" aria-hidden="true">MS</span>
      <span class="brand-copy">
        The Multi Sport Scouter
        <small>Cross-sport athlete analytics</small>
      </span>
    </a>
    <nav aria-label="Primary navigation">
      <a href={href("")} aria-current={pathname === base ? "page" : undefined}>Home</a>
      <a href={href("explorer/")} aria-current={active("explorer/") ? "page" : undefined}>Player Explorer</a>
      <!--<a href={href("stories/")} aria-current={isStories ? "page" : undefined}>Featured Examples</a>-->
      <!--<a href={href("research/")} aria-current={active("research/") && !isFindings ? "page" : undefined}>Method</a>-->
      <a href={href("research/findings/")} aria-current={isFindings ? "page" : undefined}>Project Report & Findings</a>
    </nav>
  </div>
</header>

