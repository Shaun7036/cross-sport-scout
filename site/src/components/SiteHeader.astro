---
const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const active = (path: string) => pathname.startsWith(href(path));
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={href("")} aria-label="Athlete Translation Lab home">
      <span class="brand-mark" aria-hidden="true">AT</span>
      <span class="brand-copy">
        Athlete Translation Lab
        <small>Cross-sport role research</small>
      </span>
    </a>
    <nav aria-label="Primary navigation">
      <a href={href("")} aria-current={pathname === base ? "page" : undefined}>Overview</a>
      <a href={href("explorer/")} aria-current={active("explorer/") ? "page" : undefined}>Explorer</a>
      <a href={href("research/")} aria-current={active("research/") ? "page" : undefined}>Research</a>
      <a href={href("research/findings/")}>Findings</a>
      <a href={href("research/validation/")}>Validation</a>
    </nav>
  </div>
</header>

