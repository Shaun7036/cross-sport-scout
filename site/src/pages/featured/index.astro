---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<BaseLayout
  title="Featured Player Stories · The Multi Sport Scouter"
  description="The featured player directory and model stories now live together on one page."
>
  <main class="section">
    <div class="narrow-shell">
      <p class="eyebrow">Featured players</p>
      <h1>The featured profiles and stories now live together.</h1>
      <p class="lead">Choose from all fourteen featured athletes, then read the model's result, the real-world logic behind it and the most important caution on one guided page.</p>
      <div class="hero-actions">
        <a class="button" href={`${href("stories/")}#featured-players`}>Browse featured player stories</a>
        <a class="button secondary" href={href("explorer/")}>Open the full explorer</a>
      </div>
    </div>
  </main>
</BaseLayout>
