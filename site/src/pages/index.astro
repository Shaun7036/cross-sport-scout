---
import MetricCard from "../components/MetricCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<BaseLayout
  title="The Multi Sport Scouter"
  description="Explore how athletes rank in their own sport, then compare their build and playing profile with roles across the NFL, NBA, NHL, and Premier League."
>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div>
        <p class="eyebrow">NFL · NBA · NHL · Premier League</p>
        <h1>The Multi Sport <em>Scouter.</em></h1>
        <p class="lead">What if a sport's scouting pool extended beyond its native context?
          This project aims to make this a possibility. By first measuring a player in their own league and role, we use ensemble inference models to explore how their build and playing profile fits across other sports. </p>
        <div class="hero-actions">
          <a class="button" href={href("explorer/")}>Open the player explorer</a>
          <a class="button secondary" href={href("research/")}>See how it was built</a>
        </div>
        <p class="hero-footnote">Built from five seasons of player data across four top leagues.</p>
      </div>

      <aside class="hero-flow" aria-label="What the explorer shows">
        <p class="eyebrow">How does it work?</p>
        <div class="hero-flow-step">
          <span>1</span>
          <div>
            <strong>Infer & Build Native Sport Models</strong>
            <p>We build sport specific models which see how a player compares with peers in their current sport.</p>
          </div>
        </div>
        <div class="flow-connector" aria-hidden="true"></div>
        <div class="hero-flow-step">
          <span>2</span>
          <div>
            <strong>Validate with Future Forecast</strong>
            <p>We then use our models to see if we can reliably predict a player's next season performance via inference.</p>
          </div>
        </div>
        <div class="flow-connector" aria-hidden="true"></div>
        <div class="hero-flow-step">
          <span>3</span>
          <div>
            <strong>Evaluate Cross-Sport Fits</strong>
            <p>We then use the athlete’s build and broad playing style to see how they might fit sports with ensemble models.</p>
          </div>
        </div>
        <p class="flow-note">Cross-sport scores describe archetype resemblances (i.e. player traits). They are not probabilities of successfully changing sports.</p>
      </aside>
    </div>
  </section>

  <section class="shell" aria-label="Project snapshot">
    <div class="metric-grid">
      <MetricCard value="4" label="top leagues" note="NFL, NBA, NHL and Premier League" />
      <MetricCard value="27,652" label="player-seasons" note="A frozen five-season research panel" />
      <MetricCard value="26" label="broad roles" note="Compared inside their own sport first" />
      <MetricCard value="2021–25" label="seasons studied" note="With 2025 held out for forward testing" />
    </div>
  </section>

  <section class="section" id="how-it-works">
    <div class="shell">
