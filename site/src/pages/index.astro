---
import MetricCard from "../components/MetricCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const cases = [
  {
    league: "NHL",
    name: "Connor McDavid",
    copy: "Start with an elite native season, then inspect why the model sees an unusual NBA guard analogy.",
    query: "player=nhl%3A8478402&sport=nba&role=guard&basis=transfer",
  },
  {
    league: "NBA",
    name: "Stephen Curry",
    copy: "See why an elite scoring dimension and a broader all-around guard rating answer different questions.",
    query: "player=nba%3A3975&sport=nhl&role=right_wing&basis=transfer",
  },
  {
    league: "NBA",
    name: "LeBron James",
    copy: "A strong native validation case whose creation profile remains visible inside the broader model.",
    query: "player=nba%3A1966&sport=nfl&role=EDGE&basis=transfer",
  },
  {
    league: "NFL",
    name: "T.J. Watt",
    copy: "Return to the project’s possession-winning origin through pressure and defensive disruption.",
    query: "player=nfl%3A00-0033886&sport=nhl&role=defense&basis=transfer",
  },
  {
    league: "Premier League",
    name: "Virgil van Dijk",
    copy: "Explore the difference between a familiar target-role build and a claim about playing ability.",
    query: "player=epl%3Afpl%3A97032&sport=nba&role=forward&basis=physical",
  },
  {
    league: "NHL",
    name: "Adrian Kempe",
    copy: "The one current native profile where related-role partial pooling cleared its evidence gate.",
    query: "player=nhl%3A8477960&sport=nhl&role=right_wing&basis=transfer",
  },
];
---

<BaseLayout
  title="Athlete Translation Lab"
  description="A transparent research project comparing athlete builds and broad playing profiles across the NFL, NBA, NHL, and Premier League."
>
  <section class="home-hero">
    <div class="shell home-hero-grid">
      <div>
        <p class="eyebrow">NFL · NBA · NHL · Premier League</p>
        <h1>Compare athletic roles without pretending they are <em>the same.</em></h1>
        <p class="lead">This project measures athletes against peers in their own role, forecasts the next season cautiously, and then creates transparent cross-sport analogies from build and broad playing profile.</p>
        <div class="hero-actions">
          <a class="button" href={href("explorer/")}>Explore a player</a>
          <a class="button secondary" href={href("research/")}>Read the research</a>
        </div>
      </div>
      <aside class="hero-note">
        <strong>A comparison, not a conversion probability.</strong>
        <p>A 90th-percentile analogy does not mean a player has a 90% chance of succeeding in another sport. It means their available build and playing profile resemble patterns associated with that target role.</p>
      </aside>
    </div>
  </section>

  <section class="shell" aria-label="Project snapshot">
    <div class="metric-grid">
      <MetricCard value="27,652" label="player-seasons" note="Frozen five-season research panel" />
      <MetricCard value="4" label="top leagues" note="One sport-specific pipeline per league" />
      <MetricCard value="26" label="broad roles" note="Including explicit abstention roles" />
      <MetricCard value="2021–25" label="evaluation window" note="2025 is the frozen forward test" />
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">How it works</p>
          <h2>Three questions, kept deliberately separate.</h2>
        </div>
        <p>Separating description, forecasting and analogy prevents a familiar body type from being mistaken for proven skill.</p>
      </div>
      <div class="card-grid">
        <article class="card">
          <span class="card-number">01</span>
          <h3>What happened?</h3>
          <p>Place the completed season against players in the same sport, broad role and season.</p>
        </article>
        <article class="card">
          <span class="card-number">02</span>
          <h3>What might happen next?</h3>
          <p>Use only prior information to estimate the following season, with a reported prediction range.</p>
        </article>
        <article class="card">
          <span class="card-number">03</span>
          <h3>What looks transferable?</h3>
          <p>Compare listed build and shared performance themes while retaining every evidence warning.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Curated examples</p>
          <h2>Start with cases that reveal how the model behaves.</h2>
        </div>
        <p>The portfolio edition intentionally ships a small set of derived examples. The full 6,904-player research snapshot remains local while source rights are reviewed.</p>
      </div>
      <div class="card-grid">
        {cases.map((item) => (
          <article class="card case-card">
            <span class="league-chip">{item.league}</span>
            <h3>{item.name}</h3>
            <p>{item.copy}</p>
            <a href={`${href("explorer/")}?${item.query}`}>Open this profile →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="shell section-heading">
      <div>
        <p class="eyebrow">The central boundary</p>
        <h2>Models can identify resemblance. They cannot prove adaptation.</h2>
      </div>
      <p>The dataset does not observe enough real elite cross-sport transfers to validate actual success after changing technique, tactics, equipment, training environment or injury exposure.</p>
    </div>
  </section>
</BaseLayout>

