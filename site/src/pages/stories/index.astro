---
import BaseLayout from "../../layouts/BaseLayout.astro";
import storyCatalogData from "../../data/featured-stories.json";
import manifestData from "../../../public/data/manifest.json";
import "../../styles/stories.css";

interface Player {
  id: string;
  name: string;
  sport: string;
  sport_label: string;
  team?: string;
  role?: string;
  detail_path: string;
}

interface FeaturedCase {
  player_id: string;
}

interface Sport {
  id: string;
  label: string;
  roles: Array<{ id: string; label: string }>;
}

interface Manifest {
  featured_players: Player[];
  featured_cases: FeaturedCase[];
  sports: Sport[];
}

interface StoryCopy {
  player_id: string;
  slug: string;
  tag: string;
  target_sport: string;
  target_role: string;
  native_score: number;
  fit_score: number | null;
  fit_status: string;
  body_score: number | null;
  body_outside: boolean;
  noticed: string;
  logic: string;
  caution: string;
  source_label?: string;
  source_url?: string;
  warning?: boolean;
}

interface StoryCatalog {
  stories: StoryCopy[];
}

const manifest = manifestData as Manifest;
const catalog = storyCatalogData as StoryCatalog;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const sportLabel = (sportId: string) =>
  manifest.sports.find((sport) => sport.id === sportId)?.label || sportId.toUpperCase();
const roleLabel = (sportId: string, roleId?: string) =>
  manifest.sports
    .find((sport) => sport.id === sportId)
    ?.roles.find((role) => role.id === roleId)?.label ||
  String(roleId || "").replaceAll("_", " ");
const explorerHref = (player: string, sport: string, role: string) =>
  `${href("explorer/")}?${new URLSearchParams({ player, sport, role, basis: "transfer" })}`;
const isNumber = (value: unknown): value is number =>
  typeof value === "number" && Number.isFinite(value);
const formatScore = (value: unknown) => (isNumber(value) ? value.toFixed(1) : "Withheld");

const playerById = new Map(manifest.featured_players.map((player) => [player.id, player]));
const copyById = new Map(catalog.stories.map((story) => [story.player_id, story]));
const orderedIds = manifest.featured_cases.map((item) => item.player_id);
const uniqueSlugs = new Set(catalog.stories.map((story) => story.slug));

if (catalog.stories.length !== orderedIds.length || copyById.size !== orderedIds.length) {
  throw new Error("Every featured player must have exactly one story.");
}
if (uniqueSlugs.size !== catalog.stories.length) {
  throw new Error("Featured story anchors must be unique.");
}

const stories = orderedIds.map((playerId, index) => {
  const player = playerById.get(playerId);
  const copy = copyById.get(playerId);
  if (!player || !copy) throw new Error(`Missing featured story data for ${playerId}`);
  if (copy.target_sport === player.sport) {
    throw new Error(`${player.name}'s featured story must use another sport.`);
  }
  const targetSport = manifest.sports.find((sport) => sport.id === copy.target_sport);
  const targetRole = targetSport?.roles.find((role) => role.id === copy.target_role);
  if (!targetSport || !targetRole) {
    throw new Error(`Unknown target role for ${player.name}: ${copy.target_sport}:${copy.target_role}`);
  }
  if (!isNumber(copy.fit_score) && !copy.fit_status.startsWith("withheld_")) {
    throw new Error(`${player.name}'s unavailable score needs an explicit withheld status.`);
  }

  return {
    ...copy,
    index: index + 1,
    player,
    route: `${player.sport_label} ${roleLabel(player.sport, player.role)} → ${sportLabel(copy.target_sport)} ${roleLabel(copy.target_sport, copy.target_role)}`,
  };
});
---

<BaseLayout
  title="Featured Player Stories | The Multi Sport Scouter"
  description="Fourteen plain-English player stories showing why the model finds certain cross-sport comparisons—and where human judgment still matters."
>
  <section class="stories-hero">
    <div class="narrow-shell">
      <p class="eyebrow"><h3>Featured player examples</h3></p>
      <!--<h1>When a player's profile points somewhere unexpected</h1>-->
      <p class="lead">The Scouter first measures an athlete against people in the same role and sport. It then evaluates for a different question: does this athlete's build and broad playing style resemble a role in another sport?</p>
      <p class="stories-disclaimer"><strong>These are comparisons, not career predictions.</strong> They do not say that an athlete could change sports successfully.</p>
    </div>
  </section>

  <section class="featured-directory shell" id="featured-players" aria-labelledby="featured-title">
    <div class="directory-heading">
      <div>
        <p class="eyebrow">Fourteen interesting cross-sport cases</p>
        <h2 id="featured-title">Choose a featured player</h2>
      </div>
      <p>Select a player to jump to their analysis.</p>
    </div>
    <nav class="featured-nav-grid" aria-label="Featured player stories">
      {stories.map((story) => {
        const fitAvailable = isNumber(story.fit_score);
        return (
          <a class:list={["featured-nav-card", { "is-warning": story.warning, "is-withheld": !fitAvailable }]} href={`#${story.slug}`}>
            <span>{String(story.index).padStart(2, "0")} · {story.player.sport_label}</span>
            <strong>{story.player.name}</strong>
            <small>{story.route}</small>
            <em>{fitAvailable ? `${formatScore(story.fit_score)} cross-sport fit` : "Model withheld the score"}</em>
          </a>
        );
      })}
    </nav>
  </section>

  <!--<section class="stories-reading shell" aria-labelledby="reading-title">-->
  <!--  <div class="reading-intro">-->
  <!--    <p class="eyebrow">How to read each story</p>-->
  <!--    <h2 id="reading-title">Three numbers. Three different meanings.</h2>-->
  <!--  </div>-->
  <!--  <dl class="reading-grid">-->
  <!--    <div>-->
  <!--      <dt>Native result</dt>-->
  <!--      <dd>How the completed season compared with players in the athlete's own role.</dd>-->
  <!--    </div>-->
  <!--    <div>-->
  <!--      <dt>Cross-sport fit</dt>-->
  <!--      <dd>How strongly the model associates the athlete's build and shared playing traits with another role.</dd>-->
  <!--    </div>-->
  <!--    <div>-->
  <!--      <dt>Body fit</dt>-->
  <!--      <dd>How typical the athlete's height and weight are for that target role—not a measure of skill.</dd>-->
  <!--    </div>-->
  <!--  </dl>-->
  <!--  <p class="reading-note">A higher cross-sport number is not a promised improvement. Native and target scores compare the player with two different groups of athletes. “Withheld” means the model did not have enough support to show a responsible estimate.</p>-->
  <!--</section>-->

  <div class="story-list shell">
    {stories.map((story) => {
      const fitAvailable = isNumber(story.fit_score);
      const bodyAvailable = isNumber(story.body_score);
      const bodyOutside = story.body_outside;
      return (
        <article class:list={["story", { "story-warning": story.warning, "story-withheld": !fitAvailable }]} id={story.slug}>
          <div class="story-heading">
            <div>
              <p class="story-count">Example {String(story.index).padStart(2, "0")}</p>
              <!--<span class:list={["story-tag", { warning: story.warning || !fitAvailable }]}>{story.tag}</span>-->
              <h2>{story.player.name}</h2>
              <p class="story-route">{story.route}</p>
            </div>
            <dl class="score-strip" aria-label={`${story.player.name} model comparison`}>
              <div>
                <dt>Native result</dt>
                <dd>{formatScore(story.native_score)}<small>own-role percentile</small></dd>
              </div>
              <div class="score-featured">
                <dt>Cross-sport fit</dt>
                <dd class={!fitAvailable ? "score-unavailable" : undefined}>
                  {formatScore(story.fit_score)}
                  <small>{fitAvailable ? "fit score / 100" : "no responsible estimate"}</small>
                </dd>
              </div>
              <div>
                <dt>Body fit</dt>
                <dd class={!bodyAvailable ? "score-unavailable" : undefined}>
                  {formatScore(story.body_score)}
                  <small>{bodyOutside ? "outside target build range" : bodyAvailable ? "build centrality / 100" : "not available"}</small>
                </dd>
              </div>
            </dl>
          </div>

          <div class="story-explanation">
            <section>
              <h3>Why the model noticed this player</h3>
              <p>{story.noticed}</p>
            </section>
            <section>
              <h3>Why it makes sense in the real world</h3>
              <p>{story.logic}</p>
            </section>
            <section class="caution-box">
              <h3>What the model cannot see</h3>
              <p>{story.caution}</p>
            </section>
          </div>

          <div class="story-actions">
            <a class="button" href={explorerHref(story.player.id, story.target_sport, story.target_role)}>{fitAvailable ? "Open the full comparison" : "See why the score was withheld"}</a>
            {story.source_url && story.source_label && (
              <a class="source-link" href={story.source_url} target="_blank" rel="noreferrer">Real-world context: {story.source_label} ↗</a>
            )}
            <a class="back-link" href="#featured-players">Back to featured players ↑</a>
          </div>
        </article>
      );
    })}
  </div>

  <section class="section tint">
    <div class="shell presentation-band stories-closing">
      <div>
        <!--<p class="eyebrow">Use the stories to ask better questions</p>-->
        <!--<h2>Discovery starts the conversation. It does not finish the scouting report.</h2>-->
        <p>McDavid and Haaland show what a strong comparison can look like. Curry and Jackson show how playing style can disagree with body fit. Wembanyama and Watt show why withholding a score can be the right answer, while Kastelic shows why a high score still needs context.</p>
      </div>
      <div class="presentation-actions">
        <a class="button" href={href("explorer/")}>Explore all player profiles</a>
        <a href={href("research/limitations/")}>Read the model's limits →</a>
      </div>
    </div>
  </section>
</BaseLayout>
