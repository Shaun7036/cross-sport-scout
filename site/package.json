{
  "name": "multi-sport-scouter-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "data": "uv run python ../scripts/export_portfolio_site.py --root .. --output public/data",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "7.4.2",
    "cross-env": "10.1.0",
    "typescript": "6.0.3"
  }
}
