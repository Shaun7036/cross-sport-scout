* text=auto

# Keep scripts and source files consistent when the repository is cloned on Windows.
*.sh text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Generated figures and document artifacts are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.parquet binary
